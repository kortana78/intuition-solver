# Copy to .env and fill in. Never commit .env. Manual mode needs NO keys.
# Autonomous mode reads these variables.

# Generic OpenAI-compatible endpoint (works for OpenAI, Together, OpenRouter, vLLM, Ollama, LM Studio, etc.)
INTUITION_PROVIDER=openai_compatible
INTUITION_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: separate models per role
# INTUITION_ANALOGY_MODEL=
# INTUITION_SOLVER_MODEL=
# INTUITION_RECONSTRUCTOR_MODEL=

# Budgets / safety
INTUITION_MAX_MODEL_CALLS=30
INTUITION_MAX_TOKENS=100000
INTUITION_TIME_LIMIT_S=1800
